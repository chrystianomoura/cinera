{
  "name": "cinera",
  "private": true,
  "version": "1.1.0",
  "description": "Catálogo de filmes curado por algoritmo: um robô monta as fileiras todo dia, o site é estático na borda do Cloudflare e um Worker guarda as chaves de API.",
  "license": "MIT",
  "author": "Chrystiano Moura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrystianomoura/cinera.git"
  },
  "homepage": "https://cinera.party",
  "bugs": {
    "url": "https://github.com/chrystianomoura/cinera/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:search": "tsx scripts/audit-search.ts",
    "curate:aclamados": "tsx scripts/curate-aclamados.ts",
    "curate:classicos": "tsx scripts/curate-classicos.ts",
    "curate:em-alta": "tsx scripts/curate-em-alta.ts",
    "curate:novidades": "tsx scripts/curate-novidades.ts",
    "curate:populares": "tsx scripts/curate-populares.ts",
    "curate:generos": "tsx scripts/curate-generos.ts",
    "curate:hero": "tsx scripts/build-hero.ts",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "test:catalog": "tsx scripts/test-catalog.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
