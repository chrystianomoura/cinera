# Cabeçalhos do Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

# --- Segurança, em todas as respostas ---
# static.cloudflareinsights.com e cloudflareinsights.com: métricas de visitas do Cloudflare (sem cookies), que ele injeta sozinho.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://image.tmdb.org; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# --- Cache ---
# A página inicial nunca fica guardada, para um novo deploy chegar na hora.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Arquivos do app têm o hash no nome: podem ficar guardados para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O catálogo muda uma vez por dia: o navegador revalida a cada 5 minutos.
/catalog.json
  Cache-Control: public, max-age=300, must-revalidate
/categories.json
  Cache-Control: public, max-age=300, must-revalidate
/imdb.json
  Cache-Control: public, max-age=300, must-revalidate
/genres/*
  Cache-Control: public, max-age=300, must-revalidate

# Logos e ícone quase nunca mudam.
/providers/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
