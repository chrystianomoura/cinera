# --- App (vão para o navegador: qualquer visitante consegue ver) ---
# Use chaves próprias e de uso restrito. Nunca coloque aqui uma chave paga.

# TMDB (https://www.themoviedb.org/settings/api): token de leitura OU chave (os scripts de curadoria exigem o token)
VITE_TMDB_API_TOKEN=
VITE_TMDB_API_KEY=

# OMDb, só para a nota do IMDb na ficha: use uma chave GRATUITA, separada da dos scripts
VITE_OMDB_API_KEY=

# --- Scripts de curadoria (rodam só no seu computador e na CI; ficam em .env.local, nunca no navegador) ---

# OMDb (pode ser paga): usada só por `npm run build:catalog`
OMDB_SCRIPT_KEY=
# Teto de chamadas ao OMDb por execução (padrão: 20000)
# OMDB_RUN_BUDGET=20000
